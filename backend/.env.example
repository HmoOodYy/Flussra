# ============================================================
# Payroll App V3 — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# PostgreSQL connection (asyncpg driver)
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://payroll_user:change_me@localhost:5432/payroll_v3

# JWT signing secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_64_character_hex_string

# Token lifetime in hours (default: 8)
ACCESS_TOKEN_EXPIRE_HOURS=8

# Environment tag: development | staging | production
# Enables SQL echo logging when set to "development"
ENVIRONMENT=development
